{
  "name": "voz-nota",
  "version": "1.0.0",
  "private": true,
  "description": "App de voz a texto con transcripciones guardadas",
  "main": "electron/main.cjs",
  "scripts": {
    "build:web": "vite build --base=./ --outDir=www --emptyOutDir",
    "android:sync": "npm run build:web && cap sync android",
    "android:add": "npm run build:web && cap add android && cap sync android",
    "desktop:win": "npm run build:web && electron-builder --win nsis --x64 --publish never",
    "desktop:mac": "npm run build:web && electron-builder --mac dmg --publish never",
    "desktop:linux": "npm run build:web && electron-builder --linux AppImage --x64 --publish never",
    "dist": "npm run build:web && electron-builder --publish never"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "electron": "36.9.5",
    "electron-builder": "26.0.12",
    "vite": "6.4.1"
  },
  "build": {
    "appId": "com.voznota.app",
    "productName": "Voz Nota",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    }
  }
}
